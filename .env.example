# Mint address (CA). Empty = "Announced at launch" everywhere.
VITE_CA=

# Chat backend. POST { messages, tier, mode } -> streams plain text.
# Empty = local demo answers (see src/lib/chatApi.ts).
VITE_CHAT_API=

# Early-access form endpoint (receives FormData). Empty = local confirmation only.
VITE_ACCESS_API=

# Read-only Solana RPC used for the holder check, and the minimum balance that counts as a holder.
VITE_SOLANA_RPC=https://api.mainnet-beta.solana.com
VITE_HOLD_MIN=
